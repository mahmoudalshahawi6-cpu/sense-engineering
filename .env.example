# Public site URL (set to your actual Netlify/Vercel URL after deployment)
NEXT_PUBLIC_SITE_URL=https://sense-engineering.netlify.app

# PostgreSQL / Supabase database connection string (include sslmode=require for hosted DBs)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require

# Required in production. Generate with: openssl rand -hex 48
AUTH_SECRET=replace-with-a-random-96-character-hex-secret

# Supabase Storage (required on serverless hosts such as Netlify/Vercel)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY
SUPABASE_PRIVATE_BUCKET=sense-private
SUPABASE_PUBLIC_BUCKET=sense-media

# Email delivery through Resend (required for real email verification and password reset)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=SENSE <no-reply@your-verified-domain.com>
ADMIN_NOTIFY_EMAIL=your-admin-email@example.com

# Optional public contact information shown on the website
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Optional for persistent local/on-premise storage only; do not rely on local disk on serverless hosting
# PRIVATE_STORAGE_DIR=/var/data/sense-storage
